{
  "id": "youtube-music",
  "name": "YouTube Music",
  "version": "0.1.1",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "music.youtube.com",
      "s.youtube.com",
      "api.betterlyrics.org"
    ],
    "process": [
      "ffmpeg",
      "yt-dlp",
      "deno",
      "node",
      "bun",
      "/opt/homebrew/bin/ffmpeg",
      "/opt/homebrew/bin/yt-dlp",
      "/opt/homebrew/bin/deno",
      "/opt/homebrew/bin/node",
      "/opt/homebrew/bin/bun",
      "/usr/local/bin/ffmpeg",
      "/usr/local/bin/yt-dlp",
      "/usr/local/bin/deno",
      "/usr/local/bin/node",
      "/usr/local/bin/bun"
    ]
  },
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart"
    },
    {
      "title": "New Releases",
      "page": "new",
      "icon": "star"
    },
    {
      "builtin": "stations"
    },
    {
      "builtin": "liked"
    }
  ]
}
